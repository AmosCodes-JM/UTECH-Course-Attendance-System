# Copy this file to server/.env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# PostgreSQL connection strings (role/password created by scripts/setup-local-db.sh).
# Use letters, digits and underscores in the password so it needs no URL-encoding.
DATABASE_URL="postgresql://attendance_user:CHANGE_ME@localhost:5432/attendance_db"
# Separate, disposable database for the automated tests (all data is wiped).
TEST_DATABASE_URL="postgresql://attendance_user:CHANGE_ME@localhost:5432/attendance_test_db"

# Long random string used to sign the session cookie. Generate one with:
#   openssl rand -hex 48
SESSION_SECRET=

# Browser origin(s) of the React app, comma-separated. Used for CORS and the
# CSRF origin check. In production set this to your public HTTPS URL.
CLIENT_URL=http://localhost:5173

# --- Optional settings (defaults shown) ---------------------------------------
# Timezone for "today" (current semester) and attendance date filters.
# APP_TIMEZONE=America/Jamaica
# How long a lecturer/admin login lasts without activity.
# SESSION_MAX_AGE_HOURS=8
# Set to 1 when running behind a reverse proxy that terminates HTTPS.
# TRUST_PROXY=0
# Serve the built React app (client/dist) from this Express server.
# SERVE_CLIENT=false
# bcrypt cost factor.
# BCRYPT_ROUNDS=12
# Rate limits: max requests per window (minutes) per client IP.
# RATE_LIMIT_CHECKIN_MAX=600
# RATE_LIMIT_CHECKIN_WINDOW_MIN=10
# RATE_LIMIT_REGISTER_MAX=30
# RATE_LIMIT_REGISTER_WINDOW_MIN=15
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MIN=15

# --- Development seed only (npm run db:seed) ----------------------------------
# SEED_ADMIN_PASSWORD=
# SEED_LECTURER_PASSWORD=
